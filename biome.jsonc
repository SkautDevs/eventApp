{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"files": {
		"includes": ["www/*.js", "www/js/**", "www/css/**", "www/events/*/style.css", "tests/js/**", "!www/vendor"]
	},
	"formatter": {
		"enabled": false,
		"indentStyle": "tab",
		"lineWidth": 160
	},
	"css": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"bracketSpacing": false,
			"arrowParentheses": "asNeeded",
			"semicolons": "always"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"useArrowFunction": "off",
				"useOptionalChain": "off"
			},
			"style": {
				"useTemplate": "off",
				"noDescendingSpecificity": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["www/js/**", "www/css/**", "tests/js/**"],
			"formatter": {
				"enabled": true
			}
		},
		{
			// permanent: the worker is linted for new mistakes and otherwise left as it is
			"includes": ["www/sw.js"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off"
					},
					"suspicious": {
						"useIterableCallbackReturn": "off"
					}
				}
			}
		}
	]
}
