{% extends "_layout.twig" %}

{% set pageTitle = 'Odkazy' %}
{% set activeTab = 'links' %}

{% block content %}
	{% if 'handbook' in event.features %}
		<p><a class="highlight" href="{{ url_for('handbook-download') }}">Handbook (PDF) <i class="fas fa-book"></i></a></p>
	{% endif %}

	{% for link in links %}
		<p><a {% if link.highlight ?? false %}class="highlight" {% endif %}href="{{ link.href }}">{{ link.label }} {% if link.icon %}<i class="{{ link.icon }}"></i>{% endif %}{% if link.suffix ?? false %} {{ link.suffix }}{% endif %}</a></p>
	{% endfor %}
{% endblock %}
