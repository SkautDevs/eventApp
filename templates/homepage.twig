{% extends fragment ? "_screen.twig" : "_layout.twig" %}

{% set activeTab = 'homepage' %}

{% block content %}
	{% if (event.assets.mainLogoDark ?? false) and (event.assets.mainLogo ?? false) %}
		{# the identity's own artwork, one drawing per mode: the purple ghost is close to
		   invisible on a near-black ground, so dark mode gets the lime one instead #}
		<img class="logo mainLogo mode-light-only" src="{{ event.assets.mainLogo }}" alt="{{ event.name }}">
		<img class="logo mainLogo mode-dark-only" src="{{ event.assets.mainLogoDark }}" alt="{{ event.name }}">
	{% elseif event.assets.mainLogo ?? false %}
		<img class="logo mainLogo" src="{{ event.assets.mainLogo }}" alt="{{ event.name }}">
	{% endif %}

	{% if 'push' in event.features and vapidPublicKey %}
		<p class="push-enable">
			<button class="btn btn-primary" onclick="enablePush()">
				Aktivuj si notifikace o akci!
			</button>
		</p>
		<p class="push-status" role="status" hidden></p>
	{% endif %}

	{# only the urgent ones — the full list lives on the Odkazy screen #}
	{% for link in links|filter(link => link.highlight ?? false) %}
		<p><a class="highlight" href="{{ link.href }}">{{ link.label }} {% if link.icon %}<i class="{{ link.icon }}"></i>{% endif %}{% if link.suffix ?? false %} {{ link.suffix }}{% endif %}</a></p>
	{% endfor %}

	<div class="colophon">
		{% if event.homepage.footerLogo ?? false %}
			<p><img class="logo" src="{{ event.homepage.footerLogo }}" alt=""></p>
		{% endif %}
		<p>{{ event.homepage.footerText }} <a href="{{ event.homepage.footerLinkHref }}">{{ event.homepage.footerLinkLabel }}</a></p>
		<p class="credit"><a href="https://devs.skauting.cz/" target="_blank">S ❤ vybrousil Lung</a></p>
	</div>
{% endblock %}
