{% extends fragment ? "_screen.twig" : "_layout.twig" %}

{% set activeTab = 'homepage' %}
{% set eventName = event.shortName ?? event.name %}

{% block content %}
	{# kissj no longer knew the reader's session while this page was rendered: logged out here, and told so #}
	{% if toast ?? null %}
		{% include '_toast.twig' with {title: toast.title, line: toast.line} only %}
	{% endif %}
	{% if (event.assets.mainLogoDark ?? false) and (event.assets.mainLogo ?? false) %}
		{# the identity's own artwork, one drawing per mode: a mark drawn for a pale
		   ground is close to invisible on a near-black one, so dark mode gets its own #}
		<img class="logo mainLogo mode-light-only" src="{{ event.assets.mainLogo }}" alt="{{ event.name }}">
		<img class="logo mainLogo mode-dark-only" src="{{ event.assets.mainLogoDark }}" alt="{{ event.name }}">
	{% elseif event.assets.mainLogo ?? false %}
		<img class="logo mainLogo" src="{{ event.assets.mainLogo }}" alt="{{ event.name }}">
	{% endif %}

	{# logged out, in every phase: the way in #}
	{% if not home.paired %}
		{% include '_pair_card.twig' %}
	{% endif %}

	{% if home.phase == 'before' %}
		{% include '_install.twig' %}
		{% include '_notifications.twig' %}

		<h2 class="home-kicker">Co tě čeká</h2>
		{% if home.window and home.window.state == 'before' %}
			<article class="link-card"><h3>Přihlašování na programy</h3><p>{{ home.window.label }}</p></article>
		{% elseif home.window and home.window.state == 'open' %}
			{% if home.paired %}
				<article class="link-card"><h3>Výběr programů</h3><p>{{ home.window.label }}</p><a class="btn btn-primary" href="{{ url_for('programs-overview') }}">Vybrat programy</a></article>
			{% else %}
				<article class="link-card"><h3>Výběr programů</h3><p>{{ home.window.label }}</p><p>Výběr programů je otevřený. Programy si můžeš prohlédnout v sekci Program.</p></article>
			{% endif %}
		{% endif %}
		{# www/js/home/countdown.js redraws the days from the device clock, and hides the card once the
		   start has come: a copy cached the day before still counts right #}
		{% set days = home.countdown.days %}
		{% set unit = days == 1 ? 'den' : (days >= 2 and days <= 4 ? 'dny' : 'dní') %}
		{% set countdown %}<h3>Potkáme se už za <span data-countdown-days>{{ days }}</span> <span data-countdown-unit>{{ unit }}</span></h3><p>{{ home.countdown.range }}</p>{% endset %}
		{% if 'programs' in event.features %}
			<a class="link-card countdown" data-countdown data-start="{{ home.countdown.start }}" href="{{ url_for('programs') }}">{{ countdown }}</a>
		{% else %}
			<div class="link-card countdown" data-countdown data-start="{{ home.countdown.start }}">{{ countdown }}</div>
		{% endif %}
	{% else %}
		{# www/js/home/ and www/js/ui/reltime.js redraw the day and each relative time from the device clock, so a
		   copy cached yesterday names today. Which notifications count as today's stays the
		   server's choice: a copy read the next day still lists the day it was fetched on,
		   each saying "včera …", until the network brings a fresh one. #}
		<h2 class="home-date" data-home-date>{{ home.todayLabel }}</h2>
		{% if 'info' in event.features %}
			{# today's notifications as full cards, the same markup as on Informace #}
			{% for item in home.news %}
				<div class="news" data-key="message-{{ item.id }}">
					<p><strong>{{ item.title }}</strong> <small class="news-when" data-sent-at="{{ item.at }}">{{ item.when }}</small></p>
					{% if item.programme is not null %}<p class="news-programme">{{ item.programme }}</p>{% endif %}
					<p class="news-body">{{ item.body }}</p>
				</div>
			{% endfor %}
			<p><a class="btn" href="{{ url_for('info') }}">Starší notifikace</a></p>
		{% endif %}

		{# The participant's programmes. Every one of theirs is here: the server shows the
		   running one and the next two with their lead lines (HomeModel), which is what a reader
		   without JavaScript sees, and hides the rest. www/js/home/nextup.js picks them again
		   by the device clock and rewrites each lead, so a copy cached days ago (or read
		   offline) still names the right ones. The server hides the box when everything is over. #}
		{% if home.nextUp %}
			<section class="next-up" aria-label="Tvůj program" data-next-up{% if home.nextUp.index is null %} hidden{% endif %}>
				<h2>Můj program</h2>
				{% for item in home.nextUp.items %}
					<a class="link-card is-highlight next-card" href="{{ url_for('programs-mine') }}#section-{{ item.sectionId }}-program-{{ item.id }}" data-key="{{ item.id }}" data-start="{{ item.start }}" data-end="{{ item.end }}" data-time="{{ item.time }}" data-until="{{ item.until }}"{% if item.location %} data-location="{{ item.location }}"{% endif %} data-deep-link{% if not item.shown %} hidden{% endif %}>
						<div class="link-card-text">
							<p class="next-name">{{ item.name }}</p>
							<p class="next-lead" data-next-lead>{{ item.lead }}</p>
							{% if item.section %}<p class="next-section">{{ item.section }}</p>{% endif %}
						</div>
					</a>
				{% endfor %}
			</section>
		{% endif %}

		{% include '_install.twig' %}
		{% include '_notifications.twig' %}
	{% endif %}

	{# only the urgent ones — the full list is on Informace #}
	{% for link in links|filter(link => link.highlight ?? false) %}
		<p><a class="highlight" href="{{ link.href }}"{% if link.href starts with 'http://' or link.href starts with 'https://' %} target="_blank" rel="noopener"{% endif %}>{{ link.label }} {% if link.icon %}<i class="{{ link.icon }}"></i>{% endif %}{% if link.suffix ?? false %} {{ link.suffix }}{% endif %}</a></p>
	{% endfor %}

	<div class="colophon">
		{% if event.homepage.footerLogo ?? false %}
			<p><img class="logo" src="{{ event.homepage.footerLogo }}" alt=""></p>
		{% endif %}
		{% if event.homepage.footerLinkHref ?? false %}
			<p>{{ event.homepage.footerText }} <a href="{{ event.homepage.footerLinkHref }}" target="_blank" rel="noopener">{{ event.homepage.footerLinkLabel }}</a></p>
		{% endif %}
		<p class="credit"><a href="https://devs.skauting.cz/" target="_blank">S ❤ vybrousil Lung</a></p>
	</div>
{% endblock %}
