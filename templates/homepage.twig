{% extends fragment ? "_screen.twig" : "_layout.twig" %}

{% set activeTab = 'homepage' %}

{% block content %}
	{% if (event.assets.mainLogoDark ?? false) and (event.assets.mainLogo ?? false) %}
		{# the identity's own artwork, one drawing per mode: the purple ghost is close to
		   invisible on a near-black ground, so dark mode gets the lime one instead #}
		<img class="logo mainLogo mode-light-only" src="{{ event.assets.mainLogo }}" alt="{{ event.name }}">
		<img class="logo mainLogo mode-dark-only" src="{{ event.assets.mainLogoDark }}" alt="{{ event.name }}">
	{% elseif event.assets.mainLogo ?? false %}
		<img class="logo mainLogo" src="{{ event.assets.mainLogo }}" alt="{{ event.name }}">
	{% endif %}

	{# The one block that must work with no signal: the home screen is in the worker's
	   precache, and a tel: link needs no network to dial. #}
	{% if emergency.contacts ?? false %}
		<section class="emergency" aria-label="V nouzi">
			<ul class="emergency-list">
				{% for contact in emergency.contacts %}
					<li>
						<a class="emergency-call" href="{{ 'tel:' ~ contact.phone|replace({' ': ''}) }}">
							<span class="emergency-label">{{ contact.label }}</span>
							<span class="emergency-number">{{ contact.phone }}</span>
							{% if contact.note ?? false %}<span class="emergency-note">{{ contact.note }}</span>{% endif %}
						</a>
					</li>
				{% endfor %}
			</ul>
			{% for line in emergency.info ?? [] %}
				<p class="emergency-info">{{ line }}</p>
			{% endfor %}
		</section>
	{% endif %}

	{# The participant's next programme. Every one of theirs is here and www/shell.js shows
	   the first not yet over by the device clock, so a cached copy stays right; the
	   server's pick is what shows without JS. #}
	{% if nextUp %}
		<section class="next-up" aria-label="Tvůj program" data-next-up{% if nextUp.index is null %} hidden{% endif %}>
			{% for item in nextUp.items %}
				<a class="link-card is-highlight next-card" href="{{ url_for('programs') }}#muj-program-{{ item.id }}" data-key="{{ item.id }}" data-start="{{ item.start }}" data-end="{{ item.end }}" data-deep-link{% if loop.index0 != nextUp.index %} hidden{% endif %}>
					<i class="link-card-icon far fa-calendar-check" aria-hidden="true"></i>
					<span class="link-card-text">
						<span class="link-card-note next-card-kicker" data-next-kicker>Tvůj další program</span>
						{{ item.name }}
						<span class="link-card-note">{{ item.day }} · {{ item.time }}{% if item.location %} · {{ item.location }}{% endif %}</span>
					</span>
				</a>
			{% endfor %}
		</section>
	{% endif %}

	{% if 'push' in event.features %}
		<p class="push-enable">
			<button type="button" class="btn btn-primary" data-push-toggle>
				Aktivuj si notifikace o akci!
			</button>
		</p>
		<p class="push-status" role="status" hidden></p>
	{% endif %}

	{# only the urgent ones — the full list lives on the Odkazy screen #}
	{% for link in links|filter(link => link.highlight ?? false) %}
		<p><a class="highlight" href="{{ link.href }}"{% if link.href starts with 'http://' or link.href starts with 'https://' %} target="_blank" rel="noopener"{% endif %}>{{ link.label }} {% if link.icon %}<i class="{{ link.icon }}"></i>{% endif %}{% if link.suffix ?? false %} {{ link.suffix }}{% endif %}</a></p>
	{% endfor %}

	<div class="colophon">
		{% if event.homepage.footerLogo ?? false %}
			<p><img class="logo" src="{{ event.homepage.footerLogo }}" alt=""></p>
		{% endif %}
		{% if event.homepage.footerLinkHref ?? false %}
			<p>{{ event.homepage.footerText }} <a href="{{ event.homepage.footerLinkHref }}" target="_blank" rel="noopener">{{ event.homepage.footerLinkLabel }}</a></p>
		{% endif %}
		<p class="credit"><a href="https://devs.skauting.cz/" target="_blank">S ❤ vybrousil Lung</a></p>
	</div>
{% endblock %}
