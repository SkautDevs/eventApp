{% extends fragment ? "_screen.twig" : "_layout.twig" %}

{% set pageTitle = 'Mapa' %}
{% set activeTab = 'map' %}

{% block content %}
	{% if embedUrl %}
		<div class="map">
			<iframe src="{{ embedUrl }}" title="Mapa areálu" allowfullscreen></iframe>
		</div>
	{% else %}
		<p class="empty">Mapa areálu se tu objeví, jakmile ji pořadatelé zveřejní.</p>
	{% endif %}
{% endblock %}
