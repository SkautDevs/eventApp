{% extends fragment ? "_screen.twig" : "_layout.twig" %}

{% set pageTitle = 'Mapa' %}
{% set activeTab = 'map' %}

{% macro google(embedUrl, withPlan) %}
		<div class="map" data-map>
			<iframe src="{{ embedUrl }}" title="Mapa areálu" allowfullscreen></iframe>
		</div>
		{# shown by www/shell.js while the phone is offline: Google's iframe is blank then.
		   It must stay the map's next sibling — that is how shell.js finds it. #}
		{# With the plan beside it the note carries a button, which may not take .empty's
		   fade (a tonal .btn at 0.8 opacity falls under AA): the note then stays opaque
		   and only its sentence is faded. #}
		{% if withPlan %}
		<p class="empty map-offline map-offline-plan" data-map-offline hidden><span class="map-offline-text">Mapa potřebuje připojení.</span> <button type="button" class="btn" data-map-view="plan">Zobrazit plán</button></p>
		{% else %}
		<p class="empty map-offline" data-map-offline hidden>Mapa potřebuje připojení.</p>
		{% endif %}
{% endmacro %}

{% macro plan(image, imageAlt) %}
	{# the plan scrolls both ways inside its box; www/map.js zooms it by its width #}
	<div class="plan" data-plan>
		<img class="plan-img" src="{{ image }}" alt="{{ imageAlt }}" data-plan-img>
	</div>
	<span class="plan-zoom">
		<button type="button" class="plan-zoom-btn" data-plan-zoom="out" aria-label="Oddálit">−</button>
		<button type="button" class="plan-zoom-btn" data-plan-zoom="in" aria-label="Přiblížit">+</button>
	</span>
{% endmacro %}

{% block content %}
	{% if embedUrl and image %}
		{# two views of one place, switched like the Program screen's: the interactive
		   map and the handbook's drawing. data-view is the reader's, not the server's. #}
		<div class="mapview" data-map-root data-map-event="{{ event.slug }}" data-view="google" data-morph-keep="data-view">
			<div class="map-pane map-pane-google" id="map-view-google" role="tabpanel" aria-labelledby="map-tab-google">
				{{ _self.google(embedUrl, true) }}
			</div>
			<div class="map-pane map-pane-plan" id="map-view-plan" role="tabpanel" aria-labelledby="map-tab-plan">
				{{ _self.plan(image, imageAlt) }}
			</div>
			<div class="tabs-wrap" data-key="tabs">
				<div class="tabs" role="tablist" aria-label="Zobrazení mapy">
					<span class="tabs-indicator" aria-hidden="true"></span>
					<button type="button" class="tabs-tab" role="tab" id="map-tab-google" aria-controls="map-view-google" aria-selected="true" data-map-view="google"><i class="fas fa-map-marked-alt" aria-hidden="true"></i> <span class="tabs-label">Mapa</span></button>
					<button type="button" class="tabs-tab" role="tab" id="map-tab-plan" aria-controls="map-view-plan" aria-selected="false" tabindex="-1" data-map-view="plan"><i class="far fa-map" aria-hidden="true"></i> <span class="tabs-label">Plán</span></button>
				</div>
			</div>
		</div>
	{% elseif embedUrl %}
		{{ _self.google(embedUrl, false) }}
	{% elseif image %}
		<div class="mapview" data-map-root data-map-event="{{ event.slug }}" data-view="plan">
			<div class="map-pane map-pane-plan">
				{{ _self.plan(image, imageAlt) }}
			</div>
		</div>
	{% else %}
		<p class="empty">Mapa areálu se tu objeví, jakmile ji pořadatelé zveřejní.</p>
	{% endif %}
{% endblock %}
