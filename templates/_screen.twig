{# The shell-less half of every screen: the same {% block content %} the layout
   renders, wrapped in the same <section> the layout wraps it in, and nothing else.
   The loader in www/app.js inserts this into the running document's <main>.

   pageTitle / activeTab are set by the extending template before this renders, exactly
   as they are for _layout.twig — the two parents read the same two variables. #}
{% set pageTitle = pageTitle|default(event.name) %}
{% set activeTab = activeTab|default('') %}
{# aria-label makes the section a named landmark, and the <h1> is the heading the app
   has never had — the app bar draws the same title but it lives inside a link, which
   cannot carry one. Both are the screen's own name, so they stay in step with it. #}
<section class="screen"
	aria-label="{{ pageTitle }}"
	data-screen="{{ screenPath }}"
	data-title="{{ pageTitle }}"
	data-doc-title="{{ pageTitle == event.name ? event.name : pageTitle ~ ' · ' ~ event.name }}"
	data-tab="{{ activeTab }}"
	tabindex="-1"><h1 class="sr-only">{{ pageTitle }}</h1>{% block content %}{% endblock %}</section>
