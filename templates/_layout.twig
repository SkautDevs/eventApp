<!DOCTYPE html>
<html lang="cs">
<head>
	<base href="/" />
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<link rel="manifest" href="events/{{ event.slug }}/site.webmanifest">
	<link rel="apple-touch-icon" sizes="180x180" href="events/{{ event.slug }}/apple-touch-icon.png">
	<link rel="icon" type="image/png" sizes="32x32" href="events/{{ event.slug }}/favicon-32x32.png">
	<link rel="icon" type="image/png" sizes="16x16" href="events/{{ event.slug }}/favicon-16x16.png">
	<link rel="mask-icon" href="events/{{ event.slug }}/safari-pinned-tab.svg" color="{{ event.colors.base }}">
	<meta name="theme-color" content="{{ event.colors.base }}">
	<link rel="stylesheet" href="https://unpkg.com/purecss@1.0.0/build/pure-min.css" integrity="sha384-nn4HPE8lTHyVtfCBi5yW9d20FjT8BJwUXyWZT9InLYax14RDjBj46LmSztkmNP9w" crossorigin="anonymous">
	<style>
		:root {
		{% for name, value in event.colors %}
			--color-{{ name }}: {{ value }};
		{% endfor %}
		}
	</style>
	<link rel="stylesheet" href="style.css?v=5">
	<meta name="vapid-public-key" content="{{ vapidPublicKey }}">
	<meta name="push-icon" content="{{ event.assets.notificationIcon }}">
	<script src="push.js" defer></script>
	<title>{{ event.name }}</title>
	{% block header %}{% endblock %}
</head>
<body class="heading-{{ event.headingStyle|default('plain') }}">
<header>
	<div class="menu pure-menu pure-menu-horizontal pure-menu-scrollable" id="{% block highlight %}{% endblock %}">
		<ul class="pure-menu-list">
			<li class="pure-menu-item">
				<a href="{{ url_for('homepage') }}" class="menu-item-homepage menu-link pure-menu-link">
					<img class="menulogo" src="{{ event.assets.menuLogo }}" alt="{{ event.name }}">
				</a>
			</li>
			{% for item in menu %}
				<li class="pure-menu-item">
					<a href="{{ url_for(item.route) }}" class="menu-item-{{ item.key }} menu-link pure-menu-link">{{ item.label }}</a>
				</li>
			{% endfor %}
		</ul>
	</div>
</header>
<main>
	{% block content %}{% endblock %}
</main>
<footer>
	<a href="https://devs.skauting.cz/" target="_blank">S ❤ vybrousil Lung</a>
</footer>
</body>
</html>
