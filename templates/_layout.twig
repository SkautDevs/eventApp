{# pageTitle / activeTab are set by the extending template before this renders #}
{% set pageTitle = pageTitle|default(event.name) %}
{% set activeTab = activeTab|default('') %}
{# an event is dark-capable only if it hand-authored a full dark role set; one that
   did not must never show a toggle that does nothing #}
{% set hasDark = event.roles.dark is defined and event.roles.dark is not empty %}
<!DOCTYPE html>
<html lang="cs">
<head>
	<base href="/" />
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
	{# The third-party origins the shell is about to pull from, warmed while the parser
	   is still in <head>: the handshake is otherwise serialised behind the tag that
	   needs it. Only the ones this event will actually use — a connection opened to a
	   host nothing fetches from is a wasted round trip, not a saved one. #}
	<link rel="preconnect" href="https://use.fontawesome.com" crossorigin>
	{% if event.theme.font is not defined %}
		{# no event font, so the body copy comes from Skaut's CDN as themix #}
		<link rel="preconnect" href="https://cdn.skauting.cz" crossorigin>
	{% endif %}
	{% if event.theme['font-url'] is defined %}
		{% set fontOrigin = event.theme['font-url']|split('/')|slice(0, 3)|join('/') %}
		<link rel="preconnect" href="{{ fontOrigin }}">
		{# Google serves the stylesheet from one origin and the font files from another,
		   and the second is where the bytes are #}
		{% if 'fonts.googleapis.com' in fontOrigin %}
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		{% endif %}
	{% endif %}
	<link rel="manifest" href="events/{{ event.slug }}/site.webmanifest">
	<link rel="apple-touch-icon" sizes="180x180" href="events/{{ event.slug }}/apple-touch-icon.png">
	<link rel="icon" type="image/png" sizes="32x32" href="events/{{ event.slug }}/favicon-32x32.png">
	<link rel="icon" type="image/png" sizes="16x16" href="events/{{ event.slug }}/favicon-16x16.png">
	{# only for an event that ships the drawing: korbo26, miquik26 and navigamus25 do not,
	   and the old unconditional link was a 404 on every page there #}
	{% if event.assets.pinnedTab ?? false %}
		<link rel="mask-icon" href="{{ event.assets.pinnedTab }}" color="{{ event.colors.base }}">
	{% endif %}
	<meta name="theme-color" content="{{ hasDark ? event.roles.light.structure|default(event.colors.base) : event.colors.base }}"
		{% if hasDark %}data-light="{{ event.roles.light.structure|default(event.colors.base) }}" data-dark="{{ event.roles.dark.structure }}"{% endif %}>
	{% if hasDark %}
		{# Before first paint, not from the deferred script at the bottom: the mode has to
		   be on the root element by the time the stylesheet applies, or the reader sees a
		   frame of the wrong theme. A stored choice wins forever once made; until then
		   the device's own setting decides. #}
		<script nonce="{{ cspNonce }}">
			(function () {
				try {
					var mode = localStorage.getItem('obrokColorMode');
					if (mode !== 'dark' && mode !== 'light') {
						mode = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
					}
					document.documentElement.setAttribute('data-mode', mode);
					var meta = document.querySelector('meta[name=theme-color]');
					if (meta) {
						meta.setAttribute('content', meta.getAttribute(mode === 'dark' ? 'data-dark' : 'data-light'));
					}
				} catch (e) {
					// no storage and no matchMedia: the CSS media query still gets it right
				}
			})();
		</script>
	{% endif %}
	<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.8.1/css/all.css" integrity="sha384-50oBUHEmvpQ+1lW4y57PTFmhCaXp0ML5d60M1M7uH2+nqUivzIebhndOJK28anvf" crossorigin="anonymous">
	{# an event that names a webfont gets its stylesheet; one that doesn't gets no link at all #}
	{% if event.theme['font-url'] is defined %}
		<link rel="stylesheet" href="{{ event.theme['font-url'] }}">
	{% endif %}
	<style>
		:root {
			color-scheme: {{ hasDark ? 'light dark' : 'light' }};
		{% for name, value in event.colors %}
			--color-{{ name }}: {{ value }};
		{% endfor %}
		{# theme values are raw CSS authored in the event config, so they are emitted verbatim;
		   font-url is a document resource, not a property, and is linked above instead #}
		{% for name, value in event.theme|filter((value, name) => name != 'font-url') %}
			--theme-{{ name }}: {{ value|raw }};
		{% endfor %}
		{# the light role set is the base; the dark one overrides it twice, below #}
		{% for name, value in event.roles.light|default({}) %}
			--role-{{ name }}: {{ value|raw }};
		{% endfor %}
		}
	{% if hasDark %}
		{# Without JS there is no data-mode, so the device's setting has to reach the roles
		   on its own — but it must not override a reader who chose light. #}
		@media (prefers-color-scheme: dark) {
			:root:not([data-mode="light"]) {
				color-scheme: dark;
			{% for name, value in event.roles.dark %}
				--role-{{ name }}: {{ value|raw }};
			{% endfor %}
			}
		}
		{# and the explicit choice last, so it wins over the media query either way #}
		:root[data-mode="dark"] {
			color-scheme: dark;
		{% for name, value in event.roles.dark %}
			--role-{{ name }}: {{ value|raw }};
		{% endfor %}
		}
	{% endif %}
	</style>
	<link rel="stylesheet" href="{{ asset_version('style.css') }}">
	<meta name="vapid-public-key" content="{{ vapidPublicKey }}">
	<meta name="event-base" content="{{ base }}/">
	<meta name="push-icon" content="{{ event.assets.notificationIcon }}">
	<meta name="push-identity" content="{{ auth_tie_code() }}">
	<script src="{{ asset_version('push.js') }}" defer></script>
	{# the installed-app concerns: the offline worker on every page #}
	<script src="{{ asset_version('shell.js') }}" defer></script>
	{# the screen loader (without it every link is a plain navigation and the app is
	   exactly what it was) and the colour-mode toggle's tap #}
	<script src="{{ asset_version('app.js') }}" defer></script>
	{% if 'programs' in event.features %}
		{# the Program screen's behaviour used to be inline in <head>, which no screen swap
		   could ever reach; it lives here now and the loader calls into it #}
		<script src="{{ asset_version('programs.js') }}" defer></script>
	{% endif %}
	<title>{{ pageTitle == event.name ? event.name : pageTitle ~ ' · ' ~ event.name }}</title>
	{% block header %}{% endblock %}
</head>
<body class="screen-{{ activeTab != '' ? activeTab : 'other' }}">
{# The first stop in the tab order. Without it the only way to the app's own
   navigation is through everything above it — on /mapa that is a dozen tab stops
   inside Google's iframe before the tab bar is reached. It targets <main> rather
   than a screen, because <main> is the one anchor that survives a screen swap. The href
   carries the current path because <base href="/"> would send a bare "#obsah" to the picker. #}
<a class="skip-link" href="{{ screenPath }}#obsah">Přeskočit na obsah</a>
<header class="appbar">
	<a class="appbar-brand" href="{{ url_for('homepage') }}">
		{# The bar is filled with `state`, and `state` is the one fill that does NOT
		   flip with the mode — so the mark on it must not flip either. The mode pair
		   belongs on a surface that follows the mode; here it put obrok27's lime
		   ghost on lime and made the mark disappear at night. `menuLogoOnState` is by
		   contract the drawing for a state fill, the same one the active tab uses. #}
		{% if event.assets.menuLogoOnState ?? false %}
			<img class="appbar-logo" src="{{ event.assets.menuLogoOnState }}" alt="">
		{% elseif event.assets.menuLogo %}
			<img class="appbar-logo" src="{{ event.assets.menuLogo }}" alt="">
		{% endif %}
		<span class="appbar-title">{{ pageTitle }}</span>
	</a>
	<div class="appbar-tools">
		{% if hasDark %}
			{# the icon shows what you would switch TO; the name is constant and aria-pressed carries the state (www/app.js) #}
			<button type="button" class="appbar-mode" data-mode-toggle aria-pressed="false" aria-label="Tmavý režim">
				<i class="fas fa-moon mode-icon mode-moon" aria-hidden="true"></i>
				<i class="fas fa-sun mode-icon mode-sun" aria-hidden="true"></i>
			</button>
		{% endif %}
		{# The label is text rather than an aria-label, because an aria-label REPLACES
		   the element's contents: with one on the link, the TIE code
		   a sighted reader can see here was announced as "Přihlášení" and the
		   identity never reached a screen reader at all. #}
		<a class="appbar-profile" href="{{ url_for('profile') }}">
			<span class="sr-only">Přihlášení</span>
			{% set who = auth_identity() %}
			{% if who %}<span class="appbar-who">{{ who }}</span>{% endif %}
			<i class="fas fa-user-circle" aria-hidden="true"></i>
		</a>
	</div>
</header>

{# <main> is a stack of screens, not one screen: the first is server-rendered here and
   www/app.js appends the rest as they are first visited, hiding rather than removing the
   one it leaves. The wrapper is emitted identically by _screen.twig, so a screen that
   arrived over the wire is indistinguishable from this one. #}
<main id="obsah" tabindex="-1">
	<noscript><p class="noscript">Aplikace potřebuje zapnutý JavaScript.</p></noscript>
	{# The freshness line after the <h1> is filled by www/shell.js ("aktualizováno 14:05")
	   from the two attributes below. A template that has nothing fresh to report — the
	   Program screen when the programme list could not be read at all, the error and
	   offline pages — sets showFreshness to false. #}
	{# data-fetched-at is when the provider data on this screen was fetched (the request
	   time when it used none); data-stale marks an old copy served because kissj failed.
	   The handler has already run when this renders, so both are final here. #}
	<section class="screen"
		aria-label="{{ pageTitle }}"
		data-screen="{{ screenPath }}"
		data-title="{{ pageTitle }}"
		data-doc-title="{{ pageTitle == event.name ? event.name : pageTitle ~ ' · ' ~ event.name }}"
		data-tab="{{ activeTab }}"
		data-fetched-at="{{ data_freshness().fetchedAt }}"{% if data_freshness().stale %} data-stale="1"{% endif %}
		tabindex="-1"><h1 class="sr-only">{{ pageTitle }}</h1>{% if showFreshness ?? true %}<p class="freshness" data-freshness hidden></p>{% endif %}{% block content %}{% endblock %}</section>
</main>

{# The one live region in the app. A screen swap changes the document title and the
   app bar, neither of which any screen reader announces on its own, so www/app.js
   writes the new screen's name here after it shows one. Deliberately the only one:
   the Program screen's day strip changes on every day boundary the reader scrolls
   past, and an aria-live on it would talk over the reading. #}
<p class="sr-only" role="status" aria-live="polite" data-screen-live></p>

<nav class="tabbar" aria-label="Hlavní menu">
	{# the loading bar along the bar's top edge; www/shell.js shows it while the loader
	   waits for a screen it has never shown #}
	<span class="progress" data-progress aria-hidden="true"></span>
	{# aria-current is the only thing that tells a screen reader which of the five you
	   are on: the fill and the chip are pixels, and .is-active is a class name. #}
	<a class="tab{{ activeTab == 'homepage' ? ' is-active' }}" href="{{ url_for('homepage') }}"{% if activeTab == 'homepage' %} aria-current="page"{% endif %}>
		{# the active tab is filled with the event's own colour behind this mark, so an
		   event whose drawing is that same colour names a second one to go on the fill;
		   without one there is nothing to swap to and the single drawing stays put #}
		{% set chipLogo = event.assets.menuLogoOnState ?? '' %}
		{% set plainClass = chipLogo ? ' tab-logo-plain' : '' %}
		{% if event.assets.menuLogoDark ?? false %}
			<img class="tab-logo{{ plainClass }} mode-light-only" src="{{ event.assets.menuLogo }}" alt="">
			<img class="tab-logo{{ plainClass }} mode-dark-only" src="{{ event.assets.menuLogoDark }}" alt="">
		{% elseif event.assets.menuLogo %}
			<img class="tab-logo{{ plainClass }}" src="{{ event.assets.menuLogo }}" alt="">
		{% else %}
			<i class="fas fa-home" aria-hidden="true"></i>
		{% endif %}
		{% if chipLogo %}
			<img class="tab-logo tab-logo-chip" src="{{ chipLogo }}" alt="">
		{% endif %}
		<span>{{ event.shortName|default(event.name) }}</span>
	</a>
	{% for item in menu %}
		<a class="tab{{ activeTab == item.key ? ' is-active' }}" href="{{ url_for(item.route) }}"{% if activeTab == item.key %} aria-current="page"{% endif %}>
			<i class="{{ item.icon }}" aria-hidden="true"></i>
			<span>{{ item.label }}</span>
		</a>
	{% endfor %}
</nav>
</body>
</html>
