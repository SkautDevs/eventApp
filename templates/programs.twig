{% extends fragment ? "_screen.twig" : "_layout.twig" %}

{% set pageTitle = 'Programy' %}
{% set activeTab = 'programs' %}
{# with no programme list at all the outage notice says it; "aktualizováno" beside it would lie #}
{% set showFreshness = not programmesUnavailable %}

{% block content %}
	{# data-morph-keep names the attributes on this element that belong to the reader
	   rather than to the server: a background morph must not put the screen back on the
	   timeline because that is what a fresh render defaults to. #}
	<div class="pg" data-pg-root data-morph-keep="data-view data-step" data-pg-event="{{ event.slug }}" data-view="timeline" data-step="next">
		{% if notice %}
			<p class="notice" data-key="notice">{{ notice }}</p>
		{% endif %}

		{# One strip of day chips per view. The timeline's switches the page; the list's
		   follows the scroll and scrolls to a day when tapped. The chip of the day on
		   show carries aria-current, which the reader owns: data-morph-keep stops a
		   background morph putting it back on the server's day. #}
		{# every child of .pg carries a data-key or an id (the two views): they come and go with the data, and the morph matches unkeyed siblings by position — which once turned the sheet into a day panel #}
		{% for pager in [
			{'kind': 'timeline', 'items': pages, 'active': activePage},
			{'kind': 'list', 'items': days, 'active': activeDay}
		] %}
			{% if pager.items is not empty %}
				<div class="pager" data-key="pager-{{ pager.kind }}" data-pg-pager="{{ pager.kind }}">
					<div class="days" role="group" aria-label="Dny" data-pg-days="{{ pager.kind }}">
						{% for item in pager.items %}
							<button type="button" class="day-chip" data-key="{{ item.key }}" data-pg-page="{{ item.key }}" data-pg-kind="{{ pager.kind }}" aria-current="{{ item.key == pager.active ? 'true' : 'false' }}" data-morph-keep="aria-current">{{ item.label }}</button>
						{% endfor %}
					</div>
					{% if pager.kind == 'timeline' %}
						{# only the timeline carries an hour axis to stretch #}
						<span class="pager-zoom">
							<button type="button" class="pager-zoom-btn" data-pg-zoom="out" aria-label="Oddálit">−</button>
							<button type="button" class="pager-zoom-btn" data-pg-zoom="in" aria-label="Přiblížit">+</button>
						</span>
					{% endif %}
				</div>
			{% endif %}
		{% endfor %}

		{# --- timeline: every programme of the active day, from every section --- #}
		<div class="view view-timeline" id="pg-view-timeline" role="tabpanel" aria-labelledby="pg-tab-timeline">
			{% if pages is empty and not programmesUnavailable %}
				<p class="empty">Program zatím není k dispozici.</p>
			{% endif %}
			{% for page in pages %}
				<section class="tl-page{{ page.key == activePage ? ' is-active' }}" data-morph-keep="class" data-pg-panel="timeline" data-key="{{ page.key }}" data-label="{{ page.label }}">
					<div class="tl-scroll">
						<div class="tl-inner" style="--tl-hours: {{ page.hours }}">
							<div class="tl-ruler">
								<div class="tl-stage tl-stage-head"></div>
								<div class="tl-ticks">
									{% for tick in page.ruler %}
										{# the label is its own element, so a dense scale can thin the text without touching the mark #}
						<span class="tl-tick" style="left: calc(var(--hour-width) * {{ tick.offset }})"><span class="tl-tick-label">{{ tick.label }}</span></span>
									{% endfor %}
								</div>
							</div>
							{% for row in page.rows %}
								<div class="tl-row">
									<div class="tl-stage">{{ row.location }}</div>
									<div class="tl-tracks">
										<div class="tl-lines" aria-hidden="true"></div>
										{% for track in row.tracks %}
											<div class="tl-track">
												{% for card in track %}
													<button type="button" class="tl-card{{ card.registered ? ' is-registered' }}{{ card.dimmed ? ' is-dimmed' }}" data-key="{{ card.id }}" style="left: calc(var(--hour-width) * {{ card.offset }}); width: calc(var(--hour-width) * {{ card.span }})" data-pg-open="{{ card.id }}" aria-label="{{ card.name }}, {{ card.time }}{% if card.registered %}, přihlášeno{% endif %}">
														<span class="tl-card-name">{{ card.name }}</span>
													</button>
												{% endfor %}
											</div>
										{% endfor %}
									</div>
								</div>
							{% endfor %}
							{# keeps the stage column black and the tracks grey below the last row #}
							<div class="tl-fill" aria-hidden="true"><div class="tl-stage"></div></div>
						</div>
					</div>
				</section>
			{% endfor %}
		</div>

		{# --- list: only the programmes the logged-in participant is registered for --- #}
		<div class="view view-list" id="pg-view-list" role="tabpanel" aria-labelledby="pg-tab-list">
			{% if not isLogged %}
				<div class="login-box">
					<p>Přihlas se TIE kódem a uvidíš tady svůj vlastní program.</p>
					{% include '_tie_form.twig' with {'return': 'programy'} %}
				</div>
			{% elseif not mineRead %}
				{# the notice above says the personal list could not be read; "nothing registered" would be a guess #}
			{% elseif days is empty %}
				<p class="empty">Zatím nemáš přihlášený žádný program.</p>
			{% else %}
				{% for day in days %}
					<section class="pl-day" data-key="{{ day.key }}" data-label="{{ day.label }}">
						{# every day is present and scrolled through, so each one names itself
						   inside the scroll rather than in the strip alone #}
						<h2 class="pl-head">{{ day.label }}</h2>
						{% for item in day.items %}
							{# The card is not itself a control: as role="button" it collapsed its four
							   lines into one accessible name a hundred characters long. The name is the
							   control, and the card keeps data-pg-open so a press anywhere on it still
							   opens the sheet — the handler matches the nearest one. tabindex="-1"
							   rather than "0": no longer a tab stop, still focusable, which is what
							   closing the sheet needs to hand focus back to the card it came from. #}
							<article class="pl-item" data-key="{{ item.id }}" data-pg-open="{{ item.id }}" tabindex="-1">
								<p class="pl-time">{{ item.time }}</p>
								<h3 class="pl-name"><button type="button" class="pl-open" data-pg-open="{{ item.id }}">{{ item.name }}</button></h3>
								{% if item.location %}<p class="pl-loc">{{ item.location }}</p>{% endif %}
								{% if item.perex %}<p class="pl-perex">{{ item.perex }}</p>{% endif %}
							</article>
						{% endfor %}
					</section>
				{% endfor %}
			{% endif %}
		</div>

		{# both views are named at once, in a bar docked on top of the main tab bar #}
		<div class="tabs-wrap" data-key="tabs">
			<div class="tabs" role="tablist" aria-label="Zobrazení programu">
				<span class="tabs-indicator" aria-hidden="true"></span>
				<button type="button" class="tabs-tab" role="tab" id="pg-tab-timeline" aria-controls="pg-view-timeline" aria-selected="true" data-pg-view="timeline"><i class="far fa-calendar-alt" aria-hidden="true"></i> <span class="tabs-label">Harmonogram</span></button>
				<button type="button" class="tabs-tab" role="tab" id="pg-tab-list" aria-controls="pg-view-list" aria-selected="false" tabindex="-1" data-pg-view="list"><i class="far fa-user" aria-hidden="true"></i> <span class="tabs-label">Můj program</span></button>
			</div>
		</div>

		{# the programme detail, as a bottom sheet #}
		<div class="sheet" data-key="sheet" data-pg-sheet aria-hidden="true">
			<div class="sheet-backdrop" data-pg-close></div>
			{# The server names the first programme so the dialog is never nameless, and
			   openSheet() points it at the open one. A background morph rewrites it only
			   while the sheet is closed, because an open sheet defers the morph. #}
			<div class="sheet-card" role="dialog" aria-modal="true"{% if details is not empty %} aria-labelledby="sheet-name-{{ (details|first).id }}"{% endif %} tabindex="-1" data-pg-sheet-card>
				<div class="sheet-scroll" data-pg-sheet-scroll>
					{% for detail in details %}
						{# data-key is the morph's handle on this row: a programme added to the
						   middle of the day must not shift every detail after it #}
						<div class="sheet-body" data-key="{{ detail.id }}" data-pg-detail="{{ detail.id }}" data-page="{{ detail.page }}">
							<div class="sheet-head">
								<h2 class="sheet-name" id="sheet-name-{{ detail.id }}">{{ detail.name }}</h2>
								<div class="sheet-meta">
									<p class="sheet-when">{{ detail.when }}</p>
									{% if detail.location %}<p class="sheet-where">{{ detail.location }}</p>{% endif %}
								</div>
							</div>
							{% if detail.section %}<p class="sheet-section">{{ detail.section }}</p>{% endif %}
							{% if detail.registered %}<p class="sheet-mine"><i class="fas fa-star" aria-hidden="true"></i> Tvůj program</p>{% endif %}
							{% if detail.messages %}
								<div class="sheet-messages">
									<h3>Oznámení</h3>
									{% for message in detail.messages %}
										<p class="sheet-message"><strong>{{ message.title }}</strong> <small>{{ message.when }}</small></p>
										<p class="sheet-perex">{{ message.body }}</p>
									{% endfor %}
								</div>
							{% endif %}
							{% if detail.perex %}<p class="sheet-perex">{{ detail.perex }}</p>{% endif %}
							{% if detail.lector %}<p class="sheet-lector">{{ detail.lector }}</p>{% endif %}
							{% if detail.tools %}<p><b>S sebou:</b> {{ detail.tools }}</p>{% endif %}
							{% if detail.image %}<img class="sheet-map" src="{{ detail.image }}" alt="Mapa – {{ detail.section }}">{% endif %}
							{% if detail.attachment %}<p><a class="sheet-link" href="{{ detail.attachment.href }}">{{ detail.attachment.label }}</a></p>{% endif %}
						</div>
					{% endfor %}
				</div>
				<button type="button" class="sheet-close" data-pg-close>✕ Zavřít</button>
			</div>
		</div>
	</div>
{% endblock %}
