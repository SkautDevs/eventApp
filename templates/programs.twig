{% extends fragment ? "_screen.twig" : "_layout.twig" %}

{% set pageTitle = 'Programy' %}
{% set activeTab = 'programs' %}

{% block content %}
	{# data-morph-keep names the attributes on this element that belong to the reader
	   rather than to the server: a background morph must not put the screen back on the
	   timeline because that is what a fresh render defaults to. #}
	<div class="pg" data-pg-root data-morph-keep="data-view data-step" data-pg-event="{{ event.slug }}" data-view="timeline" data-step="next">
		{% if notice %}
			<p class="notice">{{ notice }}</p>
		{% endif %}

		{# One strip per view, and they are not the same instrument. The timeline's is a
		   pager: it steps through (day, section) pages with ‹ ›. The list's is an
		   orientation strip over one continuous scroll: ↑ ↓ jump between day headings and
		   the label names the day being read rather than the page being shown. #}
		{% for pager in [
			{'kind': 'timeline', 'items': pages, 'active': activePage, 'back': '‹', 'forward': '›', 'backLabel': 'Předchozí', 'forwardLabel': 'Další'},
			{'kind': 'list', 'items': days, 'active': activeDay, 'back': '↑', 'forward': '↓', 'backLabel': 'Předchozí den', 'forwardLabel': 'Další den'}
		] %}
			{% if pager.items is not empty %}
				<div class="pager" data-pg-pager="{{ pager.kind }}">
					<button type="button" class="pager-arrow{{ pager.kind == 'list' ? ' pager-arrow-day' }}" data-pg-step="-1" data-pg-kind="{{ pager.kind }}" aria-label="{{ pager.backLabel }}"{{ pager.kind == 'list' ? ' disabled' }}>{{ pager.back }}</button>
					<button type="button" class="pager-label" data-pg-menu="{{ pager.kind }}" aria-haspopup="true" aria-expanded="false">
						<span data-pg-title="{{ pager.kind }}">{{ (pager.items|filter(p => p.key == pager.active)|first).label }}</span>
						<i class="fas fa-caret-down" aria-hidden="true"></i>
					</button>
					<button type="button" class="pager-arrow{{ pager.kind == 'list' ? ' pager-arrow-day' }}" data-pg-step="1" data-pg-kind="{{ pager.kind }}" aria-label="{{ pager.forwardLabel }}"{{ pager.kind == 'list' and pager.items|length < 2 ? ' disabled' }}>{{ pager.forward }}</button>
					{% if pager.kind == 'timeline' %}
						{# only the timeline carries an hour axis to stretch #}
						<span class="pager-zoom">
							<button type="button" class="pager-zoom-btn" data-pg-zoom="out" aria-label="Oddálit">−</button>
							<button type="button" class="pager-zoom-btn" data-pg-zoom="in" aria-label="Přiblížit">+</button>
						</span>
					{% endif %}
				</div>
				<div class="pager-menu" data-pg-menu-panel="{{ pager.kind }}" aria-hidden="true">
					<div class="pager-menu-backdrop" data-pg-close></div>
					<div class="pager-menu-card" tabindex="-1" data-pg-menu-card>
						{% for item in pager.items %}
							<button type="button" class="pager-menu-item{{ item.key == pager.active ? ' is-active' }}" data-morph-keep="class" data-pg-page="{{ item.key }}" data-pg-kind="{{ pager.kind }}">{{ item.label }}</button>
						{% endfor %}
						<button type="button" class="pager-menu-close" data-pg-close>✕ Zavřít</button>
					</div>
				</div>
			{% endif %}
		{% endfor %}

		{# --- timeline: every programme of the active (day, section) page --- #}
		<div class="view view-timeline" id="pg-view-timeline" role="tabpanel" aria-labelledby="pg-tab-timeline">
			{% if pages is empty %}
				<p class="empty">Program zatím není k dispozici.</p>
			{% endif %}
			{% for page in pages %}
				<section class="tl-page{{ page.key == activePage ? ' is-active' }}" data-morph-keep="class" data-pg-panel="timeline" data-key="{{ page.key }}" data-label="{{ page.label }}">
					<div class="tl-scroll">
						<div class="tl-inner" style="--tl-hours: {{ page.hours }}">
							<div class="tl-ruler">
								<div class="tl-stage tl-stage-head"></div>
								<div class="tl-ticks">
									{% for tick in page.ruler %}
										{# the label is its own element, so a dense scale can thin the text without touching the mark #}
						<span class="tl-tick" style="left: calc(var(--hour-width) * {{ tick.offset }})"><span class="tl-tick-label">{{ tick.label }}</span></span>
									{% endfor %}
								</div>
							</div>
							{% for row in page.rows %}
								<div class="tl-row">
									<div class="tl-stage">{{ row.location }}</div>
									<div class="tl-tracks">
										<div class="tl-lines" aria-hidden="true"></div>
										{% for track in row.tracks %}
											<div class="tl-track">
												{% for card in track %}
													<button type="button" class="tl-card{{ card.registered ? ' is-registered' }}{{ card.dimmed ? ' is-dimmed' }}" data-key="{{ card.id }}" style="left: calc(var(--hour-width) * {{ card.offset }}); width: calc(var(--hour-width) * {{ card.span }})" data-pg-open="{{ card.id }}" aria-label="{{ card.name }}, {{ card.time }}">
														<span class="tl-card-name">{{ card.name }}</span>
													</button>
												{% endfor %}
											</div>
										{% endfor %}
									</div>
								</div>
							{% endfor %}
							{# keeps the stage column black and the tracks grey below the last row #}
							<div class="tl-fill" aria-hidden="true"><div class="tl-stage"></div></div>
						</div>
					</div>
				</section>
			{% endfor %}
		</div>

		{# --- list: only the programmes the logged-in participant is registered for --- #}
		<div class="view view-list" id="pg-view-list" role="tabpanel" aria-labelledby="pg-tab-list">
			{% if not isLogged %}
				<p class="login-hint"><a href="{{ url_for('profile') }}">Přihlaste se</a> a uvidíte tady svůj vlastní program.</p>
			{% elseif days is empty %}
				<p class="empty">Zatím nemáte přihlášený žádný program.</p>
			{% else %}
				{# the top of the scroll, watched by the same observer as the days: it is
				   what tells the strip that the up arrow has nowhere left to go #}
				<span class="pl-top" data-pg-list-top aria-hidden="true"></span>
				{% for day in days %}
					<section class="pl-day" data-key="{{ day.key }}" data-label="{{ day.label }}">
						{# every day is present and scrolled through, so each one names itself
						   inside the scroll rather than in the strip alone #}
						<h2 class="pl-head">{{ day.label }}</h2>
						{% for item in day.items %}
							<article class="pl-item" data-key="{{ item.id }}" data-pg-open="{{ item.id }}" role="button" tabindex="0">
								<p class="pl-time">{{ item.time }}</p>
								<h3 class="pl-name">{{ item.name }}</h3>
								{% if item.location %}<p class="pl-loc">{{ item.location }}</p>{% endif %}
								{% if item.perex %}<p class="pl-perex">{{ item.perex }}</p>{% endif %}
							</article>
						{% endfor %}
					</section>
				{% endfor %}
			{% endif %}
		</div>

		{# both views are named at once, in a bar docked on top of the main tab bar #}
		<div class="tabs-wrap">
			<div class="tabs" role="tablist" aria-label="Zobrazení programu">
				<span class="tabs-indicator" aria-hidden="true"></span>
				<button type="button" class="tabs-tab" role="tab" id="pg-tab-timeline" aria-controls="pg-view-timeline" aria-selected="true" data-pg-view="timeline"><i class="far fa-calendar-alt" aria-hidden="true"></i> <span class="tabs-label">Timeline</span></button>
				<button type="button" class="tabs-tab" role="tab" id="pg-tab-list" aria-controls="pg-view-list" aria-selected="false" tabindex="-1" data-pg-view="list"><i class="far fa-user" aria-hidden="true"></i> <span class="tabs-label">Seznam</span></button>
			</div>
		</div>

		{# the programme detail, as a bottom sheet #}
		<div class="sheet" data-pg-sheet aria-hidden="true">
			<div class="sheet-backdrop" data-pg-close></div>
			<div class="sheet-card" role="dialog" aria-modal="true" aria-label="Detail programu" tabindex="-1" data-pg-sheet-card>
				<div class="sheet-scroll" data-pg-sheet-scroll>
					{% for detail in details %}
						{# data-key is the morph's handle on this row: a programme added to the
						   middle of the day must not shift every detail after it #}
						<div class="sheet-body" data-key="{{ detail.id }}" data-pg-detail="{{ detail.id }}" data-page="{{ detail.page }}">
							<div class="sheet-head">
								<h2 class="sheet-name">{{ detail.name }}</h2>
								<div class="sheet-meta">
									<p class="sheet-when">{{ detail.when }}</p>
									{% if detail.location %}<p class="sheet-where">{{ detail.location }}</p>{% endif %}
								</div>
							</div>
							{% if detail.section %}<p class="sheet-section">{{ detail.section }}</p>{% endif %}
							{% if detail.registered %}<p class="sheet-mine"><i class="fas fa-star" aria-hidden="true"></i> Váš program</p>{% endif %}
							{% if detail.perex %}<p class="sheet-perex">{{ detail.perex }}</p>{% endif %}
							{% if detail.lector %}<p class="sheet-lector">{{ detail.lector }}</p>{% endif %}
							{% if detail.tools %}<p><b>S sebou:</b> {{ detail.tools }}</p>{% endif %}
							{% if detail.image %}<img class="sheet-map" src="{{ detail.image }}" alt="Mapa – {{ detail.section }}">{% endif %}
							{% if detail.attachment %}<p><a class="sheet-link" href="{{ detail.attachment.href }}">{{ detail.attachment.label }}</a></p>{% endif %}
						</div>
					{% endfor %}
				</div>
				<button type="button" class="sheet-close" data-pg-close>✕ Zavřít</button>
			</div>
		</div>
	</div>
{% endblock %}
