{% extends fragment ? "_screen.twig" : "_layout.twig" %}

{# Přehled and Moje are one list component: every day of the given programmes under its
   own sticky heading, in its own view container. The morph matches keys among siblings,
   so the two views may reuse the day keys and the programme ids. Dimming is Přehled's
   only; the perex is Moje's, where the list is short enough to carry it. #}
{% macro dayList(kind, days) %}
	{% for day in days %}
		{# Each list's days carry ids of their own, since both lists are in the document:
		   Přehled's `den-<YYYYMMDD>`, Moje's `moje-den-<YYYYMMDD>`; each strip's chips link to them. #}
		<section class="pl-day" data-key="{{ day.key }}" id="{{ kind == 'list' ? 'moje-' }}den-{{ day.day|replace({'-': ''}) }}" data-label="{{ day.label }}">
			{# every day is present and scrolled through, so each one names itself
			   inside the scroll rather than in the strip alone #}
			<h2 class="pl-head">{{ day.label }}</h2>
			{% for item in day.items %}
				{# The card is not itself a control: as role="button" it collapsed its lines
				   into one accessible name a hundred characters long. The name is the
				   control, a link to the sheet's hash on this address (the sheet opens on
				   :target without JavaScript; the script intercepts it), and the card keeps
				   data-pg-open so a press anywhere on it still opens the sheet — the handler
				   matches the nearest one. tabindex="-1" rather than "0": no longer a tab
				   stop, still focusable, which is what closing the sheet needs to hand focus
				   back to the card it came from. #}
				<article class="pl-item{{ item.registered ? ' is-registered' }}{{ kind == 'overview' and item.dimmed ? ' is-dimmed' }}{{ item.thumb ? ' has-thumb' }}" data-key="{{ item.id }}" data-start="{{ item.start }}" data-end="{{ item.end }}" data-pg-open="{{ item.id }}" tabindex="-1">
					<p class="pl-time">{{ item.time }}</p>
					<h3 class="pl-name"><a class="pl-open" href="{{ pageAddress }}#section-{{ item.sectionId }}-program-{{ item.id }}" data-pg-open="{{ item.id }}">{{ item.name }}</a></h3>
					<p class="pl-meta">{{ item.until }}{% if item.location %} · {{ item.location }}{% endif %}</p>
					{% if item.registered %}<span class="pl-tag">Zapsáno</span>{% endif %}
					{# The first photo's thumbnail, in a third column beside the name, over the event's
					   placeholder (_photo_mark.twig); a row without photos has no frame. Decorative:
					   the sheet carries the photos. The frame is keyed for the morph, and the thumb's
					   class is the script's (gallery.js marks it is-loaded), as the gallery's are. #}
					{% if item.thumb %}<span class="pl-thumb-frame" data-key="thumb" aria-hidden="true">{% include '_photo_mark.twig' %}<img class="pl-thumb" src="{{ item.thumb }}" alt="" loading="lazy" decoding="async" crossorigin="anonymous" data-photo data-morph-keep="class"></span>{% endif %}
					{% if kind == 'list' and item.perex %}<p class="pl-perex">{{ item.perex }}</p>{% endif %}
				</article>
			{% endfor %}
		</section>
	{% endfor %}
{% endmacro %}

{% set pageTitle = 'Programy' %}
{% set activeTab = 'programs' %}

{% block content %}
	{% import _self as pg %}
	{# data-view is the view the address names (/programy, /programy/prehled,
	   /programy/moje), painted first. data-morph-keep names the attributes on this
	   element that belong to the reader rather than to the server: a background morph
	   must not move the screen off the view the reader switched to. #}
	<div class="pg" data-pg-root data-morph-keep="data-view data-step" data-pg-event="{{ event.slug }}" data-view="{{ view }}" data-step="next">
		{# what a register or unregister said, over the sheet its deep link reopens #}
		{% if toast %}{% include '_toast.twig' with {title: toast.title, line: toast.line} %}{% endif %}
		{% if notice %}
			<p class="notice" data-key="notice">{{ notice }}</p>
		{% endif %}

		{# One strip of day chips per view. The timeline's switches the page; each list's
		   follows the scroll and scrolls to a day when tapped. Every chip is a link, so a
		   reader without JavaScript does both: the timeline's to `?den=<YYYYMMDD>`, whose
		   page the server makes active, each list's to its own day's id on this address
		   (the script intercepts them). The chip of the day on show carries aria-current,
		   which the reader owns: data-morph-keep stops a background morph putting it back
		   on the server's day. #}
		{# every child of .pg carries a data-key or an id (the two views): they come and go with the data, and the morph matches unkeyed siblings by position — which once turned the sheet into a day panel #}
		{% for pager in [
			{'kind': 'overview', 'items': overview, 'active': activeOverview},
			{'kind': 'timeline', 'items': pages, 'active': activePage},
			{'kind': 'list', 'items': days, 'active': activeDay}
		] %}
			{% if pager.items is not empty %}
				<div class="pager" data-key="pager-{{ pager.kind }}" data-pg-pager="{{ pager.kind }}">
					<div class="days" role="group" aria-label="Dny" data-pg-days="{{ pager.kind }}">
						{% for item in pager.items %}
							{% set ymd = item.day|replace({'-': ''}) %}
							<a class="day-chip" href="{{ pager.kind == 'timeline' ? url_for('programs') ~ '?den=' ~ ymd : pageAddress ~ '#' ~ (pager.kind == 'list' ? 'moje-') ~ 'den-' ~ ymd }}" data-key="{{ item.key }}" data-pg-page="{{ item.key }}" data-pg-kind="{{ pager.kind }}" aria-current="{{ item.key == pager.active ? 'true' : 'false' }}" data-morph-keep="aria-current">{{ item.label }}</a>
						{% endfor %}
					</div>
					{% if pager.kind == 'timeline' %}
						{# only the timeline carries an hour axis to stretch #}
						<span class="pager-zoom">
							<button type="button" class="pager-zoom-btn" data-pg-zoom="out" aria-label="Oddálit">−</button>
							<button type="button" class="pager-zoom-btn" data-pg-zoom="in" aria-label="Přiblížit">+</button>
						</span>
					{% endif %}
				</div>
			{% endif %}
		{% endfor %}

		{# --- Přehled: every programme, by day --- #}
		<div class="view view-overview" id="pg-view-overview" role="tabpanel" aria-labelledby="pg-tab-overview">
			{% if overview is empty and not programmesUnavailable %}
				<p class="empty">Program zatím není k dispozici.</p>
			{% endif %}
			{{ pg.dayList('overview', overview) }}
		</div>

		{# --- timeline: every programme of the active day, from every section --- #}
		<div class="view view-timeline" id="pg-view-timeline" role="tabpanel" aria-labelledby="pg-tab-timeline">
			{% if pages is empty and not programmesUnavailable %}
				<p class="empty">Program zatím není k dispozici.</p>
			{% endif %}
			{% for page in pages %}
				<section class="tl-page{{ page.key == activePage ? ' is-active' }}" data-morph-keep="class" data-pg-panel="timeline" data-key="{{ page.key }}" data-label="{{ page.label }}" data-axis-start="{{ page.axisStart }}" data-axis-end="{{ page.axisEnd }}">
					<div class="tl-scroll">
						<div class="tl-inner" style="--tl-hours: {{ page.hours }}">
							<div class="tl-ruler">
								<div class="tl-stage tl-stage-head"></div>
								<div class="tl-ticks">
									{% for tick in page.ruler %}
										{# the label is its own element, so a dense scale can thin the text without touching the mark #}
						<span class="tl-tick" style="left: calc(var(--hour-width) * {{ tick.offset }})"><span class="tl-tick-label">{{ tick.label }}</span></span>
									{% endfor %}
									{# where "now" is, on today's page only — placed and shown by www/js/programs/nowline.js #}
									<span class="tl-now-tick" aria-hidden="true"><span class="tl-now-label" data-pg-now-label></span></span>
								</div>
							</div>
							{% for row in page.rows %}
								<div class="tl-row">
									<div class="tl-stage">{{ row.location }}</div>
									<div class="tl-tracks">
										<div class="tl-lines" aria-hidden="true"></div>
										{% for track in row.tracks %}
											<div class="tl-track">
												{% for card in track %}
													{# a link to the sheet's hash on this address, as a list row's name is #}
													<a class="tl-card{{ card.registered ? ' is-registered' }}{{ card.dimmed ? ' is-dimmed' }}" href="{{ pageAddress }}#section-{{ card.sectionId }}-program-{{ card.id }}" data-key="{{ card.id }}" style="left: calc(var(--hour-width) * {{ card.offset }}); width: calc(var(--hour-width) * {{ card.span }})" data-pg-open="{{ card.id }}" aria-label="{{ card.name }}, {{ card.time }}{% if card.registered %}, zapsáno{% endif %}">
														<span class="tl-card-name">{{ card.name }}</span>
													</a>
												{% endfor %}
											</div>
										{% endfor %}
									</div>
								</div>
							{% endfor %}
							{# keeps the stage column black and the tracks grey below the last row #}
							<div class="tl-fill" aria-hidden="true"><div class="tl-stage"></div></div>
							{# the current-time line, over the cards and under the stage column #}
							<div class="tl-now" aria-hidden="true"></div>
						</div>
					</div>
				</section>
			{% endfor %}
		</div>

		{# --- Moje: only the programmes the logged-in participant is registered for --- #}
		<div class="view view-list" id="pg-view-list" role="tabpanel" aria-labelledby="pg-tab-list">
			{% if not isLogged %}
				<p class="empty"><a href="{{ url_for('profile') }}">Pro svůj program se přihlas kódem z KissJ.</a></p>
			{% elseif not mineRead %}
				{# the notice above says the personal list could not be read; "nothing registered" would be a guess #}
			{% elseif days is empty %}
				<p class="empty">Zatím nemáš zapsaný žádný program.</p>
			{% else %}
				{{ pg.dayList('list', days) }}
			{% endif %}
		</div>

		{# the three views are named at once, in a bar docked on top of the main tab bar.
		   Each pill is a link to its view's address, so a reader without JavaScript
		   switches views too; the script intercepts it. The pill of the view painted
		   first is selected and the current page; both are the reader's once the script
		   runs (views.js), so a background morph leaves them alone (data-morph-keep), as
		   it does the day chips' aria-current. No tabindex here: every pill is reachable
		   without a script, which puts the roving tabindex on at wiring. #}
		<div class="tabs-wrap" data-key="tabs">
			<div class="tabs" role="tablist" aria-label="Zobrazení programu">
				<span class="tabs-indicator" aria-hidden="true"></span>
				<a class="tabs-tab" role="tab" id="pg-tab-overview" href="{{ url_for('programs-overview') }}" aria-controls="pg-view-overview" aria-selected="{{ view == 'overview' ? 'true' : 'false' }}" data-pg-view="overview"{% if view == 'overview' %} aria-current="page"{% endif %} data-morph-keep="aria-selected aria-current"><i class="far fa-list-alt" aria-hidden="true"></i> <span class="tabs-label">Přehled</span></a>
				<a class="tabs-tab" role="tab" id="pg-tab-timeline" href="{{ url_for('programs') }}" aria-controls="pg-view-timeline" aria-selected="{{ view == 'timeline' ? 'true' : 'false' }}" data-pg-view="timeline"{% if view == 'timeline' %} aria-current="page"{% endif %} data-morph-keep="aria-selected aria-current"><i class="far fa-calendar-alt" aria-hidden="true"></i> <span class="tabs-label">Harmonogram</span></a>
				<a class="tabs-tab" role="tab" id="pg-tab-list" href="{{ url_for('programs-mine') }}" aria-controls="pg-view-list" aria-selected="{{ view == 'list' ? 'true' : 'false' }}" data-pg-view="list"{% if view == 'list' %} aria-current="page"{% endif %} data-morph-keep="aria-selected aria-current"><i class="far fa-user" aria-hidden="true"></i> <span class="tabs-label">Moje</span></a>
			</div>
		</div>

		{# the programme detail, as a bottom sheet; closed, CSS hides it (visibility), from
		   assistive technology too. Without JavaScript it opens on the :target body, and
		   the backdrop and the close row go to #zavrit, which names nothing. #}
		<div class="sheet" data-key="sheet" data-pg-sheet>
			<a class="sheet-backdrop" href="{{ pageAddress }}#zavrit" data-pg-close aria-hidden="true" tabindex="-1"></a>
			{# The server names the first programme so the dialog is never nameless, and
			   openSheet() points it at the open one. A background morph rewrites it only
			   while the sheet is closed, because an open sheet defers the morph. #}
			<div class="sheet-card" role="dialog" aria-modal="true"{% if details is not empty %} aria-labelledby="sheet-name-{{ (details|first).id }}"{% endif %} tabindex="-1" data-pg-sheet-card>
				<div class="sheet-scroll" data-pg-sheet-scroll>
					{% for detail in details %}
						{# data-key is the morph's handle on this row: a programme added to the
						   middle of the day must not shift every detail after it. The id is the
						   programme's deep link, section and programme. #}
						<div class="sheet-body" id="section-{{ detail.sectionId }}-program-{{ detail.id }}" data-key="{{ detail.id }}" data-pg-detail="{{ detail.id }}" data-page="{{ detail.page }}">
							{# The photos, a strip that snaps frame by frame, over the event's logo
							   (_photo_mark.twig) until each loads: lazy, so nothing is fetched until
							   the sheet opens (a closed body is display: none). www/js/programs/gallery.js
							   marks a loaded photo is-loaded, which fades it in, and moves the dots with
							   the strip; data-morph-keep keeps both through a background morph. A frame
							   and its dot are keyed by the photo (Sheet::$imageKeys), so a reordered or
							   replaced photo arrives in a fresh frame, not as a new src in a loaded
							   one. Without JavaScript the photo shows as it loads and the dots are
							   hidden. Two or more make the strip a focusable group, scrolled with the
							   arrow keys. #}
							{% if detail.images is not empty %}
								<div class="gallery" data-key="gallery" data-gallery>
									<div class="gallery-strip" data-gallery-strip{% if detail.images|length > 1 %} role="group" tabindex="0" aria-label="Fotky"{% endif %}>
										{% for image in detail.images %}
											<div class="gallery-frame" data-key="photo-{{ detail.imageKeys[loop.index0] }}">{% include '_photo_mark.twig' %}<img class="gallery-photo" src="{{ image.url }}" alt="{{ image.alt }}" loading="lazy" decoding="async" crossorigin="anonymous" data-photo data-morph-keep="class"></div>
										{% endfor %}
									</div>
									{% if detail.images|length > 1 %}<div class="gallery-dots" aria-hidden="true">{% for image in detail.images %}<span class="gallery-dot" data-key="dot-{{ detail.imageKeys[loop.index0] }}"{% if loop.first %} data-active{% endif %} data-morph-keep="data-active"></span>{% endfor %}</div>{% endif %}
								</div>
							{% endif %}
							<div class="sheet-head">
								<h2 class="sheet-name" id="sheet-name-{{ detail.id }}">{{ detail.name }}</h2>
								{% if detail.section %}<span class="sheet-chip">{{ detail.section }}</span>{% endif %}
							</div>
							<dl class="sheet-facts"><dt>Kdy</dt><dd>{{ detail.when }}</dd>{% if detail.location %}<dt>Kde</dt><dd>{% if detail.placeHref %}<a class="place-pin" href="{{ detail.placeHref }}" data-deep-link><i class="fas fa-map-marker-alt" aria-hidden="true"></i> {{ detail.location }}</a>{% else %}{{ detail.location }}{% endif %}</dd>{% endif %}</dl>
							{% if detail.registered %}<p class="sheet-mine"><i class="fas fa-star" aria-hidden="true"></i> Tvůj program</p>{% endif %}
							{% if detail.messages %}
								<div class="sheet-messages">
									<h3>Oznámení</h3>
									{% for message in detail.messages %}
										<p class="sheet-message"><strong>{{ message.title }}</strong> <small{% if message.at %} data-sent-at="{{ message.at }}"{% endif %}>{{ message.when }}</small></p>
										<p class="sheet-perex">{{ message.body }}</p>
									{% endfor %}
								</div>
							{% endif %}
							{% if detail.perex %}<p class="sheet-perex">{{ detail.perex }}</p>{% endif %}
							{% if detail.lector %}<p class="sheet-lector">{{ detail.lector }}</p>{% endif %}
							{% if detail.tools %}<p><b>S sebou:</b> {{ detail.tools }}</p>{% endif %}
							{# What the reader can do about it: one line, one button, or nothing. The
							   one child is keyed by its state, so a morph from "unregister" to
							   "register" replaces the form rather than patching it: the morph never
							   removes an attribute the fresh markup lacks, and a patched register
							   button would keep the unregister's data-confirm. No whitespace inside,
							   or .sheet-footer:empty stops matching. #}
							<div class="sheet-footer">
								{%- if detail.footer -%}
									{%- if detail.footer.state == 'unpaired' -%}
										<a class="btn" href="{{ url_for('profile', {}, {program: detail.id}) }}" data-key="unpaired">Pro zápis na programy se přihlas kódem z KissJ</a>
									{%- elseif detail.footer.state in ['before', 'after', 'none'] -%}
										<p class="sheet-line" data-key="{{ detail.footer.state }}">{{ detail.footer.line }}</p>
									{%- elseif detail.footer.state == 'register' -%}
										{#- data-write: www/js/shell/write.js sends it and lands on its answer in place of the entry; www/js/programs/deeplink.js first writes the view on show into pohled, which the answer lands on -#}
										<form method="post" action="{{ url_for('program-register', {id: detail.id}) }}" data-key="register" data-write><input type="hidden" name="pohled" value="{{ view }}"><button class="btn btn-primary">Zapsat program</button></form>
									{%- elseif detail.footer.state == 'unregister' -%}
										{#- the first tap asks, the second submits (www/js/shell/confirm.js) -#}
										<form method="post" action="{{ url_for('program-unregister', {id: detail.id}) }}" data-key="unregister" data-write><input type="hidden" name="pohled" value="{{ view }}"><button class="btn" data-confirm="Opravdu zrušit zápis?">Zrušit zápis</button></form>
									{%- endif -%}
								{%- endif -%}
							</div>
						</div>
					{% endfor %}
				</div>
				<a class="sheet-close" href="{{ pageAddress }}#zavrit" data-pg-close>✕ Zavřít</a>
			</div>
		</div>
	</div>
{% endblock %}
