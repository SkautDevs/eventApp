{% extends "_layout.twig" %}

{% set pageTitle = 'Programy' %}
{% set activeTab = 'programs' %}

{% block header %}
	<script type="text/javascript">
		function toggle_visibility(id) {
			let e = document.getElementById(id);
			if (e.style.display === 'none')
				e.style.display = 'inherit';
			else
				e.style.display = 'none';
		}

		function toggleByHash()
		{
            const matches = location.hash.match(/#section-(\d+)-program-(\d+)/);
            if (matches)
            {
                toggle_visibility('section-' + matches[1]);
                toggle_visibility('program-' + matches[2]);

                let elem = document.getElementById("program-detail-" + matches[2]);
                if (elem)
				{
				    setTimeout(function() {
                        elem.scrollIntoView();
					}, 300);

				}
            }
		}

		window.addEventListener('load', toggleByHash);
		window.addEventListener('hashchange', toggleByHash)
	</script>
{% endblock %}

{% block content %}
	{% if notice %}
		<p class="highlight">{{ notice }}</p>
	{% endif %}

	{% if isLogged %}
		<p class="login-hint">Váš program je označený hvězdičkou — <strong>{{ identity }}</strong></p>
	{% else %}
		<p class="login-hint"><a href="{{ url_for('profile') }}">Přihlaste se</a> a označí se vám váš program.</p>
	{% endif %}
	{% for s in sections %}
		{% if (s['programs']) %}
		<div class="section">
			<h2 class="sectionName" onclick="toggle_visibility('section-{{ s['id'] }}')">
				{{ s['title'] }}{% if s['subTitle'] %} - {{ s['subTitle'] }}{% endif %}
			</h2>
			<div id="section-{{ s['id'] }}" style="display: none">
				{% for p in s['programs'] %}
					<div class="program{{ p['registered'] ?? false ? ' is-registered' }}" id="program-detail-{{ p['id'] }}" onclick="toggle_visibility('program-{{ p['id'] }}')">
						<h3 class="programName">{% if p['registered'] ?? false %}<i class="fas fa-star" aria-label="Váš program"></i> {% endif %}{{ p['name'] }}</h3>
						<div id="program-{{ p['id'] }}" style="display: none">
							{% if (p['lector']) %}<p><b>{{ p['lector'] }}</b></p>{% endif %}
							<p>
								<i>
                                    {{ p['start']|dateToCzechDayName }} {{ p['start']['date']|date('H:i') }} -

									{% if (p['multiday']) %}
                                        {{ p['end']|dateToCzechDayName }}
                                    {% endif %}
                                    {{ p['end']['date']|date('H:i') }}
								</i>
							</p>
							<p>{% if p['location'] %}<b>{{ p['location'] }}</b>{% else %}<i>lokace nezadána</i>{% endif %}</p>
							<p>{{ p['perex'] }}</p>
							{#<p>Obsazeno {{ p['occupied'] }} ze {{ p['capacity'] }}</p>#}
							{% if (p['tools']) %}<p>S sebou: {{ p['tools'] }}</p>{% endif %}

							{% if s.image ?? false %}
								<img src="{{ s.image }}" alt="Mapa {{ s.title }}" />
							{% endif %}
							{% if s.attachment ?? false %}
								<br />
								<a href="{{ s.attachment.href }}">{{ s.attachment.label }}</a>
							{% endif %}
						</div>
					</div>
				{% endfor %}
			</div>
		</div>
        {% endif %}
	{% endfor %}
{% endblock %}
