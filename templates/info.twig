{% extends fragment ? "_screen.twig" : "_layout.twig" %}

{% set pageTitle = 'Informace' %}
{% set activeTab = 'info' %}

{% block content %}
	{# a sent message's toast, once (Toasts::take()) #}
	{% if toast ?? null %}
		{% include '_toast.twig' with {title: toast.title, line: toast.line} only %}
	{% endif %}
	{%~ if inbox %}
	{# With `inbox` the screen has two views, switched like Místa's: this content (/informace)
	   and the message form (/informace/zpravy). Both panes are always in the markup, the
	   server paints the view the address names, and after that data-view is the reader's,
	   not the server's. The Informace pane's content keeps its indentation, so an event
	   without the inbox renders it as before. #}
	<div class="infoview" data-info-root data-view="{{ view }}" data-morph-keep="data-view">
	<div class="info-pane" id="info-view-info" role="tabpanel" aria-labelledby="info-tab-info">
	{%~ endif %}
	{# The one block that must work with no signal: Informace is in the worker's precache,
	   and a tel: link needs no network to dial. #}
	{% if emergency.contacts ?? false %}
		<section class="emergency info-contact" aria-labelledby="info-contact-title">
			<h2 id="info-contact-title">Krizový kontakt akce</h2>
			{% include '_emergency_contacts.twig' with {contacts: emergency.contacts} only %}
			{% for line in emergency.info ?? [] %}
				<p class="emergency-info">{{ line }}</p>
			{% endfor %}
		</section>
	{% endif %}

	<h2>Notifikace</h2>
	{# data-key is the morph's handle on a day and on a message: a new one arrives at the
	   top and must not shift every one after it. data-sent-at is the instant www/js/ui/reltime.js
	   redraws the relative time from, so a copy read later says how long ago it is now. #}
	{% for group in groups %}
		<section class="news-day" data-key="{{ group.key }}">
			<h3>{{ group.label }}</h3>
			{% for item in group.items %}
				<div class="news" data-key="message-{{ item.id }}">
					<p><strong>{{ item.title }}</strong> <small class="news-when" data-sent-at="{{ item.at }}">{{ item.when }}</small></p>
					{% if item.programme is not null %}<p class="news-programme">{{ item.programme }}</p>{% endif %}
					<p class="news-body">{{ item.body }}</p>
				</div>
			{% endfor %}
		</section>
	{% else %}
		<p class="empty">Zatím žádné notifikace.</p>
	{% endfor %}

	{% if 'handbook' in event.features or links %}
	<h2>Rychlé odkazy</h2>
	{# one card per link: a list, so a screen reader announces how many there are #}
	<ul class="link-list">
		{% if 'handbook' in event.features %}
			<li>
				<a class="link-card is-highlight" href="{{ url_for('handbook-download') }}">
					<i class="link-card-icon fas fa-book" aria-hidden="true"></i>
					<span class="link-card-text">Handbook (PDF)</span>
				</a>
			</li>
		{% endif %}
		{% for link in links %}
			{% set external = link.href starts with 'http://' or link.href starts with 'https://' %}
			<li>
				{# a link out of the app opens in a new tab, so the app stays where it was #}
				<a class="link-card{{ (link.highlight ?? false) ? ' is-highlight' }}" href="{{ link.href }}"{% if external %} target="_blank" rel="noopener"{% endif %}>
					{% if link.icon ?? false %}<i class="link-card-icon {{ link.icon }}" aria-hidden="true"></i>{% endif %}
					<span class="link-card-text">
						{{ link.label }}{% if link.suffix ?? false %} {{ link.suffix }}{% endif %}
						{% if link.note ?? false %}<span class="link-card-note">{{ link.note }}</span>{% endif %}
					</span>
					{% if external %}<i class="link-card-out fas fa-external-link-alt" aria-hidden="true"></i><span class="sr-only"> (otevře se v nové záložce)</span>{% endif %}
				</a>
			</li>
		{% endfor %}
	</ul>
	{% endif %}
	{%~ if inbox %}
	</div>
	<div class="info-pane" id="info-view-inbox" role="tabpanel" aria-labelledby="info-tab-inbox">
		{% include '_inbox_pane.twig' %}
	</div>
	{# Each pill is a link to its view's address, so a reader without JavaScript switches
	   views too (a full page load); www/js/inbox/views.js takes a plain click, shows the
	   pane and pushes the address instead. The shown pill is selected and the current page;
	   both are the reader's once the script runs, so a background morph leaves them alone
	   (data-morph-keep). No tabindex here: views.js puts the roving tabindex on at wiring. #}
	<div class="tabs-wrap" data-key="tabs">
		<div class="tabs" role="tablist" aria-label="Zobrazení informací">
			<span class="tabs-indicator" aria-hidden="true"></span>
			<a class="tabs-tab" role="tab" id="info-tab-info" href="{{ url_for('info') }}" aria-controls="info-view-info" aria-selected="{{ view == 'info' ? 'true' : 'false' }}" data-info-view="info"{% if view == 'info' %} aria-current="page"{% endif %} data-morph-keep="aria-selected aria-current"><i class="fas fa-info-circle" aria-hidden="true"></i> <span class="tabs-label">Informace</span></a>
			<a class="tabs-tab" role="tab" id="info-tab-inbox" href="{{ url_for('inbox') }}" aria-controls="info-view-inbox" aria-selected="{{ view == 'inbox' ? 'true' : 'false' }}" data-info-view="inbox"{% if view == 'inbox' %} aria-current="page"{% endif %} data-morph-keep="aria-selected aria-current"><i class="fas fa-envelope" aria-hidden="true"></i> <span class="tabs-label">Zprávy</span></a>
		</div>
	</div>
	</div>
	{%~ endif %}
{% endblock %}
