{% extends "_layout.twig" %}

{% set pageTitle = 'Odeslat notifikaci' %}

{% block content %}
	{% if result %}
		<p><strong>Odesláno: {{ result.sent }}</strong>, odstraněno neplatných odběrů: {{ result.removed }}</p>
	{% endif %}

	<form method="post" action="{{ url_for('admin-notify') }}" class="stacked-form">
		<input type="hidden" name="token" value="{{ token }}">
		<label for="title">Titulek</label>
		<input type="text" id="title" name="title" required>
		<label for="body">Zpráva</label>
		<textarea id="body" name="body" rows="3" required></textarea>
		<button type="submit" class="btn btn-primary">Odeslat všem</button>
	</form>
{% endblock %}
