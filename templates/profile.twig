{% extends fragment ? "_screen.twig" : "_layout.twig" %}

{% set pageTitle = 'Profil' %}
{% set activeTab = 'profile' %}
{# an event is dark-capable only if it hand-authored a full dark role set #}
{% set hasDark = event.roles.dark is defined and event.roles.dark is not empty %}

{% block content %}
	{# a logout's toast, or a login's when the approval lands here (an event without Program, after the poll or the check button alike), once (Toasts::take()) #}
	{% if toast ?? null %}
		{% include '_toast.twig' with {title: toast.title, line: toast.line} only %}
	{% endif %}
	<div class="login-box">
		{% if identity %}
			{# paired: who, and what this browser can do; no code of any kind is shown #}
			<h2 class="profile-who">{% if identity.initials %}<span class="avatar">{{ identity.initials }}</span>{% else %}<i class="fas fa-user-circle" aria-hidden="true"></i>{% endif %} {{ identity.displayName }}</h2>
		{% elseif pairing %}
			{# pending: www/js/profile/pairing.js polls while this paragraph is on a visible screen;
			   without a script the reader checks with the button under the status line #}
			<p class="pairing-code" data-pairing-poll>{{ pairing.userCode }}</p>
			<p>Zadej kód v KissJ, nebo</p>
			<a class="btn btn-primary" href="{{ pairing.verificationUrl }}" target="_blank" rel="noopener">Otevřít KissJ ↗</a>
			{# not .push-status: www/js/push/ hides every one of those while it has no push status #}
			<p class="pairing-status" role="status" data-pairing-status>{{ pairing.status }}</p>
			{# no data-write: with a script the poll checks, and this form is hidden (profile.css) #}
			<form method="post" action="{{ url_for('pairing-check') }}" class="stacked-form pairing-check"><button type="submit" class="btn btn-primary">Zkontrolovat přihlášení</button></form>
			<form method="post" action="{{ url_for('pairing-start') }}" class="stacked-form" data-write>
				{% if returnProgram %}<input type="hidden" name="program" value="{{ returnProgram }}">{% endif %}
				<button type="submit" class="btn">Začít znovu</button>
			</form>
		{% else %}
			<h2>Nejsi přihlášen</h2>
			{% if outcome %}
				<p class="notice">{{ outcome }}</p>
			{% endif %}
			<p>Obsah můžeš jen prohlížet. Pro výběr programů a další akce je třeba být registrovaným účastníkem této akce a přihlásit se:</p>
			{# a sheet's login link brings ?program=<id>: the approval returns to that sheet #}
			<form method="post" action="{{ url_for('pairing-start') }}" class="stacked-form" data-write>
				{% if returnProgram %}<input type="hidden" name="program" value="{{ returnProgram }}">{% endif %}
				<button type="submit" class="btn btn-primary">Přihlásit kódem z KissJ</button>
			</form>
		{% endif %}
	</div>
	{% include '_install.twig' %}
	{% include '_notifications.twig' with {pushOn: true} %}
	{% if hasDark %}
		{# Logged in or not: the look is the browser's, not the participant's. The choice
		   lives in localStorage, so nothing is checked here: www/js/profile/mode.js checks the stored
		   one, or "system". #}
		<fieldset class="mode-control" data-mode-control>
			<legend>Vzhled</legend>
			<label><input type="radio" name="mode" value="light"> Světlý</label>
			<label><input type="radio" name="mode" value="dark"> Tmavý</label>
			<label><input type="radio" name="mode" value="system"> Podle systému</label>
		</fieldset>
	{% endif %}
	{% if identity %}
		{# the first tap asks, the second submits (www/js/shell/confirm.js) #}
		<form method="post" action="{{ url_for('pairing-revoke') }}" class="stacked-form profile-logout" data-write>
			<button type="submit" class="btn" data-confirm="Opravdu odhlásit?">Odhlásit se z aplikace</button>
		</form>
	{% endif %}
{% endblock %}
