{% extends fragment ? "_screen.twig" : "_layout.twig" %}

{% set pageTitle = 'Přihlášení' %}

{% block content %}
	<div class="login-box">
		{% if isLogged %}
			{# there is no logout: a reader stays logged in until the code stops being valid #}
			<p>Zvýrazňuje se program pro <strong>{{ identity }}</strong></p>
		{% else %}
			<p>Přihlas se a v programu se ti zvýrazní, na co máš registraci.</p>
			{% include '_tie_form.twig' %}
		{% endif %}
	</div>
	{% include '_install.twig' %}
{% endblock %}
