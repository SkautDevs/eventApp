{% extends fragment ? "_screen.twig" : "_layout.twig" %}

{% set pageTitle = 'Přihlášení' %}

{% block content %}
	<div class="login-box">
		{% if isLogged %}
			<p>Zvýrazňuje se program pro <strong>{{ identity }}</strong></p>
			<form method="post" action="{{ url_for('tie-logout') }}">
				<button type="submit" class="btn">Odhlásit TIE kód</button>
			</form>
		{% else %}
			<p>Přihlaste se a v programu se vám zvýrazní to, na co jste zaregistrovaní.</p>
			{% include '_tie_form.twig' %}
		{% endif %}
	</div>
	{# www/shell.js unhides it once Chrome offers the install, and never in an installed app #}
	<p class="install" data-install hidden><button type="button" class="btn install-btn">Přidat na plochu</button></p>
{% endblock %}
