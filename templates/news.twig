{% extends fragment ? "_screen.twig" : "_layout.twig" %}

{% set pageTitle = 'Novinky' %}
{% set activeTab = 'news' %}

{% block content %}
	{% for item in items %}
		<div class="news">
			<h3>{{ item.datetime }}</h3>
			<p>{{ item.text }}</p>
		</div>
	{% else %}
		<p>Zatím žádné novinky.</p>
	{% endfor %}
{% endblock %}
