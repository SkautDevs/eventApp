{# The event's error page. Always the whole document, even for an X-Screen request: the
   loader treats any non-200 as "not a screen" and navigates to it. #}
{% extends "_layout.twig" %}

{% set pageTitle = notFound ? 'Nenalezeno' : 'Chyba' %}
{% set showFreshness = false %}

{% block content %}
	<div class="error-page">
		{% if notFound %}
			<p>Tohle tady není.</p>
		{% else %}
			<p>Něco se pokazilo. Zkus to za chvíli.</p>
		{% endif %}
		<p><a class="highlight" href="{{ url_for('homepage') }}">Zpět na úvod</a></p>
		{% if details %}
			{# APP_DEBUG only: Slim's detail set, on our page #}
			<details class="error-details">
				<summary>Podrobnosti chyby</summary>
				<pre>{{ details }}</pre>
			</details>
		{% endif %}
	</div>
{% endblock %}
