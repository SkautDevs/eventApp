{% extends "_layout.twig" %}

{% set pageTitle = 'Harmonogram' %}
{% set activeTab = 'programs' %}

{% block content %}
	{% include '_program-switch.twig' with {'current': 'harmonogram'} %}

	{% if notice %}
		<p class="highlight">{{ notice }}</p>
	{% endif %}

	{% if isLogged %}
		<p class="login-hint">Zvýrazňuje se program pro <strong>{{ identity }}</strong></p>
	{% else %}
		<p class="login-hint"><a href="{{ url_for('profile') }}">Přihlaste se</a> a zvýrazní se vám váš program.</p>
	{% endif %}

	{% for day in schedule %}
		<h2>{{ day.day }}</h2>
		{% for column in day.columns %}
			<h3>{{ column.title }}</h3>
			<div class="border-table">
				<table class="harmonogram">
					{% for slot in column.slots %}
						<tr>
							<td>
								{{ slot.time }}<br/>
								<strong>{{ slot.title }}</strong>
								{% if slot.sectionId is defined and registeredPrograms[slot.sectionId][slot.lookupTime] is defined %}
									{% set program = registeredPrograms[slot.sectionId][slot.lookupTime] %}
									<br />
									<a href="{{ url_for('programs') }}#section-{{ slot.sectionId }}-program-{{ program.id }}" class="btn btn-success">
										<small>Váš program:</small><br />
										{{ program.name }}<br />
										<small>{{ program.lector }}</small>
									</a>
								{% endif %}
							</td>
						</tr>
					{% endfor %}
				</table>
			</div>
		{% endfor %}
	{% endfor %}
{% endblock %}
