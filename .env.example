# One instance serves every event under /<slug>/. Instance-wide settings:
# 1 = show error details (development only!)
APP_DEBUG=0
# Sentry: empty DSN = off (tests, local dev). Rates are 0..1.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0
# Release name shown in Sentry; the Docker build sets it from the git hash.
# Keep it unset in .env: env_file overrides the image's ENV APP_RELEASE, so even an
# empty line replaces the hash. Uncomment only to override the build's git hash.
# APP_RELEASE=
# Required to boot any event, development included: every event has push. Run
# php bin/generate-vapid.php once (in the php:8.3-alpine container) and paste the pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@example.cz
PUSH_DB_PATH=var/push.sqlite
# Extra push-service hosts a subscription may name, comma-separated (*.example allowed); empty in production
PUSH_ENDPOINT_HOSTS=
# kissj root, e.g. https://kissj.net
KISSJ_BASE_URL=
# Seconds a kissj answer is served from var/cache/<slug>/ before kissj is asked again (0 = ask every time; the last answer still covers an outage)
PROGRAM_CACHE_TTL=300
# Reverse proxies in front of the app (the Docker stack: 1). X-Forwarded-For is trusted only on a connection from a loopback or private address; 0 trusts nobody and uses REMOTE_ADDR
TRUSTED_PROXY_COUNT=0
# Extra proxy addresses trusted to send X-Forwarded-For besides loopback and private ones, comma-separated addresses or CIDRs (IPv4/IPv6), e.g. 198.51.100.0/24,2001:db8::/32; malformed entries are ignored
TRUSTED_PROXIES=

# Per event: the name suffixed with the slug in upper case (- becomes _).
# Program source: stub (default) | kissj
PROGRAM_PROVIDER_OBROK27=stub
# kissj programme API key for that event — it also tells kissj which event is asking
KISSJ_API_KEY_OBROK27=
# /obrok27/admin/notify?token=<this>
ADMIN_TOKEN_OBROK27=
