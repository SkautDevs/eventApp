# One instance serves every event under /<slug>/. Instance-wide settings:
# 1 = show error details (development only!)
APP_DEBUG=0
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@example.cz
PUSH_DB_PATH=var/push.sqlite
# kissj root, e.g. https://kissj.net
KISSJ_BASE_URL=

# Per event: the name suffixed with the slug in upper case (- becomes _).
# Program source: stub (default) | kissj
PROGRAM_PROVIDER_OBROK27=stub
# kissj programme API key for that event — it also tells kissj which event is asking
KISSJ_API_KEY_OBROK27=
# /obrok27/admin/notify?token=<this>
ADMIN_TOKEN_OBROK27=
