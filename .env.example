# One instance serves every event under /<slug>/. Instance-wide settings:
# 1 = show error details (development only!)
APP_DEBUG=0
# Sentry: empty DSN = off (tests, local dev). Rates are 0..1.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0
# Release name shown in Sentry; the Docker build sets it from the git hash.
# Keep it unset in .env: env_file overrides the image's ENV APP_RELEASE, so even an
# empty line replaces the hash. Uncomment only to override the build's git hash.
# APP_RELEASE=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@example.cz
PUSH_DB_PATH=var/push.sqlite
# Extra push-service hosts a subscription may name, comma-separated (*.example allowed); empty in production
PUSH_ENDPOINT_HOSTS=
# kissj root, e.g. https://kissj.net
KISSJ_BASE_URL=
# Reverse proxies in front of the app (the Docker stack: 1). 0 trusts nobody and uses REMOTE_ADDR
TRUSTED_PROXY_COUNT=0

# Per event: the name suffixed with the slug in upper case (- becomes _).
# Program source: stub (default) | kissj
PROGRAM_PROVIDER_OBROK27=stub
# kissj programme API key for that event — it also tells kissj which event is asking
KISSJ_API_KEY_OBROK27=
# /obrok27/admin/notify?token=<this>
ADMIN_TOKEN_OBROK27=
