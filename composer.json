{
    "name": "skaut/event-app",
    "description": "Modulární podpůrná aplikace pro skautské akce",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "guzzlehttp/guzzle": "^7.9",
        "minishlink/web-push": "^9.0",
        "monolog/monolog": "^3.7",
        "php-di/php-di": "^7.0",
        "sentry/sentry": "^4.1",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "slim/twig-view": "^3.4",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/panther": "^2.2"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/", "Tools\\": "tools/" }
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true
    },
    "scripts": {
        "start": "php -S localhost:8080 -t www/ bin/router.php",
        "test": "phpunit"
    }
}
