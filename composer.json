{
    "name": "skaut/event-app",
    "description": "Modulární podpůrná aplikace pro skautské akce",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "guzzlehttp/guzzle": "^8.5",
        "minishlink/web-push": "^11.0",
        "monolog/monolog": "^3.7",
        "php-di/php-di": "^7.0",
        "psr/clock": "^1.0",
        "sentry/sentry": "^4.1",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "slim/twig-view": "^3.4",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "3.95.31",
        "phpstan/phpstan": "2.3.6",
        "phpunit/phpunit": "^13.4",
        "symfony/panther": "^2.2"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/", "Tools\\": "tools/" }
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "scripts": {
        "start": "php -S localhost:8081 -t www/ bin/router.php",
        "test": "phpunit"
    }
}
